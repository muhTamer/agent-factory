# .env.example
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Embedding model (for dense/hybrid retrieval)
# Set these if your embedding model is on a different Azure resource
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.cognitiveservices.azure.com/
AZURE_OPENAI_EMBEDDING_KEY=your-embedding-key-here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# ── Environment Mode ────────────────────────────────────────────
# Set to "development" to disable all rate limiting, usage caps, and bot blocking.
# Useful for local testing and evaluation runs.
# AF_ENV=development       # development | production (default)

# ── Rate Limiting & Usage Caps (only active when AF_ENV=production) ──
# IP rate limiting (requests per window)
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# Session LLM usage cap (per chat session)
# SESSION_MAX_LLM_CALLS=50
# SESSION_TTL_SECONDS=3600

# Global daily LLM budget (all sessions combined)
# DAILY_MAX_LLM_CALLS=5000
# DAILY_WARN_THRESHOLD=0.8

# Bot protection (disable for testing with curl/httpx)
# BOT_BLOCK_ENABLED=true