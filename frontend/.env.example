# Auth is optional for local development.
# When AUTH_SECRET is not set, auth is bypassed entirely (dev user auto-signed-in).

# To enable real OAuth, set these:
# AUTH_SECRET=           # Generate with: npx auth secret
# AUTH_TRUST_HOST=true

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Facebook OAuth (optional)
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Apple OAuth (optional)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
