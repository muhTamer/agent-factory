# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# venv
.venv/

# VSCode
.vscode/

# data (track policy YAML files and BankFAQs, ignore other large data files)
data/*
!data/*.yaml
!data/*.yml
!data/BankFAQs.csv
!data/RetailFAQs.csv
*.parquet

# Node
node_modules/

# pytest cache
.pytest_cache/

# Environment & secrets
.env
!env.example
# Local configs / keys
*.key
*.pem

# Ignore generated artifacts
generated/

# Evaluation results (auto-generated by run_evaluation.py)
evaluation/results/

# Thesis output (auto-generated by thesis/ scripts)
thesis/output/

# Auto-generated runtime artifacts (written on every run — not source)
.factory/audit/
.factory/compiled_policies/
.factory/factory_spec.json
.factory/performance_history.json
.factory/test_performance_history.json
.factory/test_policy_pack.json
.workspace/
.claude/

